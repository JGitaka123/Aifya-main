# --------------------------------------------------------------------------
# AIFYA HEALTH PLATFORM ENVIRONMENT CONFIGURATION
# --------------------------------------------------------------------------

# Environment Mode (development, testing, production)
APP_ENV=development
DEBUG=True

# Database Connections
# Aifya Internal PostgreSQL
DB_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql://aifya:${DB_PASSWORD}@localhost:5432/aifya

# Q-Afya External PostgreSQL (Mary Help Hospital HMIS)
QAFYA_DB_HOST=10.0.0.51
QAFYA_DB_PORT=5432
QAFYA_DB_NAME=q-afya-hmis
QAFYA_DB_USER=aifya_service_worker
QAFYA_DB_PASSWORD=replace_with_a_strong_password

# Circuit Breaker Overrides
QAFYA_CB_THRESHOLD=5
QAFYA_CB_TIMEOUT=60

# Security and Authentication
# Use `openssl rand -hex 32` to generate these
JWT_SECRET=replace_with_openssl_rand_hex_32
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
OPENAI_API_KEY=sk-proj-youropenaiapikeyhere...

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aifyaadmin
MINIO_SECRET_KEY=replace_with_local_minio_secret
MINIO_AUDIO_BUCKET=aifya-audio
MINIO_SECURE=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=100
