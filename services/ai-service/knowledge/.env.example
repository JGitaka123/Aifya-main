# Aifya Knowledge RAG Service — Environment Variables

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8025

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://aifya_user:change_me_in_production@localhost:5432/aifya

# Auth. 'internal' verifies the HS256 tokens the api-gateway issues (the web
# app's /api/knowledge proxy forwards that token as-is), so SECRET_KEY must be
# byte-identical to services/api-gateway/.env or every request returns 401.
# 'keycloak' switches back to RS256 realm-JWKS verification.
AUTH_PROVIDER=internal
SECRET_KEY=

# Keycloak Auth (only used when AUTH_PROVIDER=keycloak)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aifya

# Qdrant Vector Store
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aifya_knowledge

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_KNOWLEDGE_BUCKET=aifya-knowledge
MINIO_SECURE=false

# Storage backend: 'minio' (the compose stack) or 'local' (plain files, no
# Docker). Leave blank to get 'minio' in production and 'local' in development.
STORAGE_BACKEND=
# Only used when STORAGE_BACKEND=local.
KNOWLEDGE_STORAGE_PATH=./data/files

# Vector backend: 'qdrant' (the compose stack) or 'local' (qdrant-client's
# embedded on-disk mode, no Docker). Leave blank for 'qdrant' in production and
# 'local' in development. Embedded mode takes an exclusive lock on the path
# below, so run exactly one uvicorn worker and keep INGEST_MODE=inline.
VECTOR_BACKEND=
QDRANT_LOCAL_PATH=./data/qdrant

# Ingestion: 'celery' (Redis-backed worker) or 'inline' (inside the upload
# request, no Redis). Leave blank for 'celery' in production, 'inline' in dev.
INGEST_MODE=

# Embeddings: 'auto' uses sentence-transformers when torch is importable and
# falls back to a deterministic hashed bag-of-words embedding otherwise, or
# force one with 'sentence-transformers' / 'hashing'. The hashing fallback
# scores lexically rather than semantically, so it needs a much lower
# SIMILARITY_THRESHOLD than the 0.45 that suits BGE-M3.
EMBEDDING_BACKEND=auto
# vLLM Generation
VLLM_BASE_URL=http://localhost:8002/v1
# Bearer token for the OpenAI-compatible endpoint above. Required by DeepSeek
# and OpenAI; leave blank for a local vLLM that does not check auth.
GENERATION_API_KEY=GENERATION_MODEL=Qwen/Qwen2.5-72B-Instruct
GENERATION_MAX_TOKENS=2048
GENERATION_TEMPERATURE=0.1

# RAG Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
SIMILARITY_THRESHOLD=0.45

# Celery
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# CORS
CORS_ORIGINS=http://localhost:3000

# Upload Limits
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
