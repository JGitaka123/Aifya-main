# =============================================================================
# Aifya Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aifya
POSTGRES_USER=aifya_user
POSTGRES_PASSWORD=replace_with_local_dev_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_local_minio_secret
MINIO_BUCKET=aifya-documents

# --- Keycloak (Auth) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aifya
KEYCLOAK_CLIENT_ID=aifya-web
API_KEYCLOAK_CLIENT_ID=aifya-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_local_keycloak_admin_password
# Temporary public beta mode. Set both backend and web flags to false before
# restoring normal Keycloak sign-in.
BETA_PUBLIC_ACCESS=false
NEXT_PUBLIC_BETA_PUBLIC_ACCESS=false
BETA_USER_ID=00000000-0000-0000-0000-000000000002
BETA_FACILITY_ID=00000000-0000-0000-0000-000000000001
BETA_USER_EMAIL=beta@aifyamed.com
BETA_USER_NAME=Aifya Beta Tester

# --- AI Services (vLLM) ---
VLLM_DEEPSEEK_R1_URL=http://localhost:8001/v1
VLLM_QWEN_72B_URL=http://localhost:8002/v1
VLLM_DISTILL_32B_URL=http://localhost:8003/v1
VLLM_MEDGEMMA_27B_URL=http://localhost:8004/v1

# --- Managed AI via LiteLLM proxy (see docs/DEPLOYMENT.md §7) ---
# ScribeAI + knowledge call the internal litellm proxy, which forwards to
# managed providers. Set these to enable AI; leave blank to disable.
ANTHROPIC_API_KEY=
# Whisper transcription provider key (Anthropic can't transcribe audio).
WHISPER_OPENAI_API_KEY=
# Override to bypass the proxy (straight to OpenAI or a self-hosted vLLM):
# OPENAI_BASE_URL=http://litellm:4000/v1
# VLLM_BASE_URL=http://litellm:4000/v1
# GENERATION_MODEL=claude-sonnet

# --- Whisper (ScribeAI) ---
WHISPER_URL=http://localhost:8005

# --- Qdrant (Vector DB) ---
QDRANT_URL=http://localhost:6333

# --- External Integrations ---
SHA_API_URL=https://claims.sha.go.ke/api/v1
SHA_API_KEY=
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.aifya.co.ke/api/v1/mpesa/callback
# Error tracking (optional): set a Sentry DSN to enable API error reporting
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Comma-separated Safaricom callback source IPs. STRONGLY recommended in
# production — without it the payment callbacks accept any caller.
MPESA_CALLBACK_IP_ENFORCE=true
# Extra callback source IPs/CIDRs beyond Safaricom's built-in ranges.
MPESA_CALLBACK_IP_ALLOWLIST=
MPESA_ENVIRONMENT=sandbox
KRA_ETIMS_URL=

# --- Africa's Talking (Bulk SMS) ---
# AT_USERNAME is the account username shown in the Africa's Talking dashboard
# beside the API key. It is NOT this placeholder and NOT your email address, and
# while it is wrong every send is refused. Sandbox apps use the literal username
# "sandbox" together with AT_SANDBOX=true.
# Not sure which one you have? This probe reports the working pair without
# spending any airtime:
#   powershell -ExecutionPolicy Bypass -File scripts\check-africastalking.ps1
AT_USERNAME=
AT_API_KEY=
# Alphanumeric sender IDs have to be registered on the account. Leave blank to
# send from the account's default shortcode.
AT_SENDER_ID=
AT_SANDBOX=false

# --- WhatsApp patient messaging (Meta WhatsApp Business Cloud API) ---
# Leave these blank to keep the WhatsApp channel switched off; the API then
# reports a clear not-configured error instead of pretending to send.
# Pick ONE WhatsApp backend.
# Green API (send from an existing number linked by QR):
# The instance must be authorized - scan its QR code in the Green API console.
# This probe reports the instance state and the raw reply to a test send:
#   powershell -ExecutionPolicy Bypass -File scripts\check-whatsapp.ps1
WA_INSTANCE_ID=
WA_ACCESS_TOKEN=
# Meta WhatsApp Business Cloud API (official, needs business verification):
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# --- Outbound patient email (SMTP with STARTTLS) ---
# Gmail/Workspace needs an App Password, not the account password.
# Set SMTP_USE_TLS=false only for a local relay without STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Aifya
SMTP_USE_TLS=true

# --- REDCap ---
REDCAP_API_URL=
# Tokens stored in Vault, not here

# --- App Config ---
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_REWRITE_URL=http://localhost:8000/api/v1
# Server-side base URL for the knowledge service (used by the web app's
# /api/knowledge cookie-auth proxy; the browser never calls it directly).
KNOWLEDGE_SERVICE_URL=http://localhost:8025
SCRIBE_SERVICE_URL=http://localhost:8005
NEXT_PUBLIC_SCRIBE_API_URL=http://localhost:8005
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=aifya
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=aifya-web
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_local_nextauth_secret
# Internal-auth HS256 secret. MUST be identical everywhere a token is signed
# or verified: services/api-gateway/.env, and the api-gateway/api-worker/
# api-beat/knowledge-service/knowledge-worker containers. The web app's
# /api/knowledge proxy forwards the api-gateway's token straight through, so a
# mismatch shows up as a 401 on the Knowledge tab.
SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_SECRET=replace_with_local_scribe_jwt_secret
FACILITY_TIMEZONE=Africa/Nairobi
CORS_ORIGINS=http://localhost:3000
