{
  "realm": "aifya",
  "enabled": true,
  "displayName": "Aifya HMIS",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername",
  "roles": {
    "realm": [
      { "name": "admin", "description": "System administrator" },
      { "name": "billing", "description": "Billing desk" },
      { "name": "billing_clerk", "description": "Billing clerk" },
      { "name": "billing_officer", "description": "Billing officer (insurance claims)" },
      { "name": "cashier", "description": "Billing / cashier" },
      { "name": "clinician", "description": "Clinician (generic clinical role)" },
      { "name": "dentist", "description": "Dentist / dental surgeon" },
      { "name": "doctor", "description": "Medical doctor / clinical officer" },
      { "name": "facility_admin", "description": "Facility administrator" },
      { "name": "finance_admin", "description": "Finance administrator" },
      { "name": "hospital_administrator", "description": "Hospital administrator" },
      { "name": "hr", "description": "Human resources" },
      { "name": "hr_admin", "description": "HR administrator" },
      { "name": "hr_officer", "description": "HR officer" },
      { "name": "investigator", "description": "Clinical trials investigator" },
      { "name": "lab_tech", "description": "Laboratory technologist" },
      { "name": "medical_records", "description": "Medical records officer" },
      { "name": "midwife", "description": "Midwife" },
      { "name": "nurse", "description": "Registered nurse / enrolled nurse" },
      { "name": "pathologist", "description": "Pathologist" },
      { "name": "pharmacist", "description": "Pharmacist" },
      { "name": "principal_investigator", "description": "Clinical trials principal investigator" },
      { "name": "rad_tech", "description": "Radiography technologist" },
      { "name": "radiologist", "description": "Radiologist / imaging tech" },
      { "name": "receptionist", "description": "Reception / front desk" },
      { "name": "records", "description": "Health records / registration clerk" },
      { "name": "research_coordinator", "description": "Clinical trials coordinator" },
      { "name": "specialist", "description": "Specialist consultant" },
      { "name": "staff", "description": "Unrecognised title (Patients + User Guide only)" },
      { "name": "store_keeper", "description": "Store keeper" },
      { "name": "super_admin", "description": "Platform super administrator" },
      { "name": "triage_nurse", "description": "Triage nurse" },
      { "name": "ward_nurse", "description": "Ward nurse" }
    ]
  },
  "clients": [
    {
      "clientId": "aifya-web",
      "name": "Aifya Web Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://www.aifyamed.com/*",
        "https://aifyamed.com/*"
      ],
      "webOrigins": [
        "https://www.aifyamed.com",
        "https://aifyamed.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://www.aifyamed.com/*##https://aifyamed.com/*"
      },
      "defaultClientScopes": ["openid", "profile", "email", "aifya-scope"]
    },
    {
      "clientId": "aifya-api",
      "name": "Aifya API Gateway",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "defaultClientScopes": ["openid", "profile", "email", "aifya-scope"]
    }
  ],
  "clientScopes": [
    {
      "name": "aifya-scope",
      "description": "Aifya custom claims (facility_id)",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "facility_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "facility_id",
            "claim.name": "facility_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "aifya-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "aifya-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@aifyamed.com",
      "email": "admin@aifyamed.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "System",
      "lastName": "Admin",
      "attributes": {
        "facility_id": ["00000000-0000-0000-0000-000000000001"]
      },
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": ["admin"]
    }
  ]
}
